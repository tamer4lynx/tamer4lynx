{
  "name": "@tamer4lynx/tamer-stack",
  "publishConfig": {
    "access": "public",
    "tag": "prerelease"
  },
  "version": "0.0.1",
  "type": "module",
  "description": "Native stack navigation element for Lynx — zero-bitmap push/pop using a live FrameLayout/UIView stack.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android/src",
    "android/build.gradle.kts",
    "ios",
    "lynx.ext.json"
  ],
  "lynx": {
    "ext": "lynx.ext.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.100.0",
    "@lynx-js/types": ">=3.3.0",
    "react": "^17.0.0"
  },
  "devDependencies": {
    "@lynx-js/react": "^0.112.1",
    "@lynx-js/types": "3.3.0",
    "@types/react": "^17.0.0",
    "react": "^17.0.2",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamer4lynx/tamer-stack.git"
  },
  "author": "Nanofuxion",
  "license": "MIT"
}
