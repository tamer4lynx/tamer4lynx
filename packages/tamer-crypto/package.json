{
  "name": "@tamer4lynx/tamer-crypto",
  "version": "0.0.1",
  "publishConfig": { "access": "public", "tag": "prerelease" },
  "type": "module",
  "description": "Web Crypto–shaped API for Lynx with native iOS/Android crypto (SHA, AES-GCM, HMAC, PBKDF2, HKDF, ECDSA P-256, RSA-OAEP).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "android/src", "android/build.gradle.kts", "ios", "lynx.ext.json", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test:vectors": "node scripts/verify-vectors.mjs"
  },
  "devDependencies": {
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamer4lynx/tamer4lynx.git",
    "directory": "packages/tamer-crypto"
  },
  "license": "MIT"
}
